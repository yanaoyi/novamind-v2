# NovaMind V2 后端配置示例
# 复制为 .env 后修改。.env 不允许提交 Git。

# 运行环境：development | production
APP_ENV=development

# HTTP 监听地址
HTTP_ADDR=127.0.0.1:8080

# PostgreSQL（apt 安装的默认实例）
# 注意：示例文件会进 Git，这里必须是占位符；真实口令只写在 .env（已被 .gitignore 排除）。
# 2026-10-04 安全修复：本行此前带着真实口令被提交进公开仓库，已改为占位符。
# 仓库曾出现过该口令，使用者请自行更换：ALTER USER novamind PASSWORD '新口令';
DATABASE_URL=postgres://novamind:CHANGE_ME@127.0.0.1:5432/novamind?sslmode=disable

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 日志：debug | info | warn | error
LOG_LEVEL=info

# 文件存储根目录（Phase 2 起使用）
STORAGE_DIR=./data/uploads

# 单次上传大小上限（MB）
UPLOAD_MAX_MB=50

# 用于加密模型 API Key 的主密钥（务必自己生成并备份；丢失后已保存的 Key 只能重填）
# 生成方式：openssl rand -base64 48
NOVAMIND_SECRET=

# 接口访问令牌：所有 /api/v1 业务接口都要求 Authorization: Bearer <ADMIN_TOKEN>。
# 生成方式：openssl rand -hex 32
# 生产环境（APP_ENV=production）不配置则**拒绝启动**；开发环境不配置会放行并在日志里告警。
# 前端首次访问会弹出"需要访问令牌"，把这里的值粘进去即可（只存在浏览器 localStorage）。
ADMIN_TOKEN=

# 允许把模型 api_base 指向内网/本机（SSRF 收敛开关，默认关闭）。
# 只有本地开发与冒烟测试（假模型服务跑在 127.0.0.1）才需要打开；生产环境务必保持关闭。
ALLOW_PRIVATE_MODEL_BASE=false

# Model Gateway 密钥一律通过界面写入数据库（加密存储），不在这里配置。
